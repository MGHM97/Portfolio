---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedWork } from '../../lib/work';

export const getStaticPaths = (async () => {
  const work = await getPublishedWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={`${data.title} — Mateus Vieira`} description={data.summary}>
  <Header />
  <main id="main" class="container">
    <article>
      <header class="intro">
        <a class="back" href="/#work">
          ← All work
        </a>
        <p class="meta">
          {data.company} · {data.role} · {data.period}
        </p>
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>

        <dl class="facts">
          {data.outcomes.length > 0 && (
            <div>
              <dt>Outcomes</dt>
              <dd>
                <ul>
                  {data.outcomes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          <div>
            <dt>Stack</dt>
            <dd>{data.stack.join(' · ')}</dd>
          </div>
        </dl>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 8vw, 4rem) 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(1.875rem, 5vw, 2.75rem);
  }

  .summary {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .facts {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0.375rem 0 0;
  }

  dd ul {
    padding-left: 1.1rem;
  }

  .prose {
    padding-block: 2.5rem 5rem;
  }

  .prose :global(h2) {
    margin-top: 3rem;
    font-size: 1.5rem;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.1875rem;
  }

  .prose :global(:is(p, ul, ol)) {
    margin-top: 1rem;
  }

  .prose :global(li + li) {
    margin-top: 0.375rem;
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    background: var(--surface);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose :global(blockquote) {
    margin-top: 1.5rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
</style>
