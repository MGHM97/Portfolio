---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {
  defaultLocale,
  formatDate,
  languageTags,
  localeParams,
  localizePath,
  t,
} from '../../../i18n';
import { getPosts, readingMinutes } from '../../../lib/posts';
import { articleSchema, serializeJsonLd } from '../../../lib/structured-data';
import '../../../styles/prose.css';

export const getStaticPaths = (async () => {
  const pages = await Promise.all(
    localeParams().map(async ({ params, props: { locale } }) => {
      const posts = await getPosts(locale);
      return posts.map((item) => ({
        params: { ...params, slug: item.slug },
        props: { locale, item },
      }));
    }),
  );
  return pages.flat();
}) satisfies GetStaticPaths;

const { locale, item } = Astro.props;
const { entry, isFallback } = item;
const { data } = entry;
const { Content } = await render(entry);
const dict = t(locale);
const contentLang = isFallback ? languageTags[defaultLocale] : undefined;
const published = data.published.toISOString().slice(0, 10);
const schema = articleSchema({
  title: data.title,
  description: data.description,
  published: data.published,
  updated: data.updated,
  url: new URL(Astro.url.pathname, Astro.site),
  contentLocale: isFallback ? defaultLocale : locale,
  site: Astro.site!,
});
---

<Base
  locale={locale}
  title={`${data.title} — Mateus Vieira`}
  description={data.description}
  canonicalLocale={isFallback ? defaultLocale : locale}
>
  <script is:inline slot="head" type="application/ld+json" set:html={serializeJsonLd(schema)} />
  <Header locale={locale} />
  <main id="main" class="container">
    <article>
      <header class="intro">
        <a class="back" href={`${localizePath(locale)}#writing`}>
          ← {dict.writing.allPosts}
        </a>

        {isFallback && <p class="notice">{dict.writing.fallbackNotice}</p>}

        <p class="meta">
          <time datetime={published}>{formatDate(locale, data.published)}</time>
          {' · '}
          {dict.writing.readingTime(readingMinutes(entry.body))}
        </p>
        <div lang={contentLang}>
          <h1>{data.title}</h1>
          <p class="summary">{data.description}</p>
        </div>
      </header>

      <div class="prose article-body" lang={contentLang}>
        <Content />
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 8vw, 4rem) 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .notice {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
    font-size: 0.9375rem;
  }

  .meta {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.125rem, 6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .summary {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--muted);
  }
</style>
