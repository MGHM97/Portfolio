---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { defaultLocale, languageTags, localeParams, localizePath, t } from '../../../i18n';
import { getWork } from '../../../lib/work';
import '../../../styles/prose.css';

export const getStaticPaths = (async () => {
  const pages = await Promise.all(
    localeParams().map(async ({ params, props: { locale } }) => {
      const work = await getWork(locale);
      return work.map((item) => ({
        params: { ...params, slug: item.slug },
        props: { locale, item },
      }));
    }),
  );
  return pages.flat();
}) satisfies GetStaticPaths;

const { locale, item } = Astro.props;
const { entry, isFallback } = item;
const { data } = entry;
const { Content } = await render(entry);
const dict = t(locale);
const contentLang = isFallback ? languageTags[defaultLocale] : undefined;
---

<Base
  locale={locale}
  title={`${data.title} — Mateus Vieira`}
  description={data.summary}
  canonicalLocale={isFallback ? defaultLocale : locale}
>
  <Header locale={locale} />
  <main id="main" class="container">
    <article>
      <header class="intro">
        <a class="back" href={`${localizePath(locale)}#work`}>
          ← {dict.work.allWork}
        </a>

        {isFallback && <p class="notice">{dict.work.fallbackNotice}</p>}

        <div lang={contentLang}>
          <p class="meta">
            {data.company} · {data.role} · {data.period}
          </p>
          <h1>{data.title}</h1>
          <p class="summary">{data.summary}</p>
        </div>

        <dl class="facts">
          {data.outcomes.length > 0 && (
            <div>
              <dt>{dict.work.outcomes}</dt>
              <dd lang={contentLang}>
                <ul role="list">
                  {data.outcomes.map((outcome) => (
                    <li>{outcome}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          <div>
            <dt>{dict.work.stack}</dt>
            <dd>{data.stack.join(' · ')}</dd>
          </div>
        </dl>
      </header>

      <div class="prose article-body" lang={contentLang}>
        <Content />
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 8vw, 4rem) 0;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .notice {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
    font-size: 0.9375rem;
  }

  .meta {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.125rem, 6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .summary {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .facts {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--border);
  }

  dt {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  dd {
    margin: 0.375rem 0 0;
  }

  dd ul {
    padding: 0;
    list-style: none;
  }

  dd li {
    position: relative;
    padding-inline-start: 1.5rem;
  }

  dd li::before {
    content: '—';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
  }
</style>
