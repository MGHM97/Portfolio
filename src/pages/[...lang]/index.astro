---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import SelectedWork from '../../components/SelectedWork.astro';
import OpenSource from '../../components/OpenSource.astro';
import Writing from '../../components/Writing.astro';
import Experience from '../../components/Experience.astro';
import Skills from '../../components/Skills.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { localeParams } from '../../i18n';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <SelectedWork locale={locale} />
    <OpenSource locale={locale} />
    <Writing locale={locale} />
    <Experience locale={locale} />
    <Skills locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
