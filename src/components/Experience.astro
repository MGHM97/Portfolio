---
import { education, experience } from '../data/profile';
---

<section id="experience" class="container section" aria-labelledby="experience-title">
  <h2 id="experience-title" class="section-title">
    Experience
  </h2>

  <ol role="list" class="timeline">
    {experience.map((job) => (
      <li class="entry">
        <p class="period">{job.period}</p>
        <div>
          <h3>
            {job.role} <span class="company">· {job.company}</span>
          </h3>
          <ul>
            {job.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <h2 class="section-title education-title">Education</h2>
  <ol role="list" class="timeline">
    {education.map((item) => (
      <li class="entry">
        <p class="period">{item.period}</p>
        <h3>
          {item.degree} <span class="company">· {item.school}</span>
        </h3>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline {
    display: grid;
    gap: 2.5rem;
    padding: 0;
  }

  .entry {
    display: grid;
    gap: 0.25rem 2rem;
  }

  @media (min-width: 40rem) {
    .entry {
      grid-template-columns: 9rem 1fr;
    }
  }

  .period {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .company {
    font-weight: 400;
    color: var(--muted);
  }

  ul {
    margin-top: 0.625rem;
    padding-left: 1.1rem;
    color: var(--muted);
  }

  li + li {
    margin-top: 0.375rem;
  }

  .education-title {
    margin-top: 4rem;
  }
</style>
