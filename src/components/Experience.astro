---
import { education, experience, spokenLanguages } from '../data/profile';
import { formatCountry, formatMonth, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { experience: copy } = t(locale);
---

<section id="experience" class="container section" aria-labelledby="experience-title">
  <h2 id="experience-title" class="section-title">
    {copy.title}
  </h2>

  <ol role="list" class="timeline">
    {experience.map((job) => {
      const { role, note, highlights } = copy.jobs[job.id];
      return (
        <li class="entry">
          <p class="period">
            <time datetime={job.start}>{formatMonth(locale, job.start)}</time>
            {' — '}
            {job.end ? (
              <time datetime={job.end}>{formatMonth(locale, job.end)}</time>
            ) : (
              copy.present
            )}
          </p>
          <div>
            <h3>
              {role} <span class="company">· {job.company}</span>
            </h3>
            <p class="where">
              {job.via && <>{copy.via(job.via)} · </>}
              {job.city}, {formatCountry(locale, job.country)} · {copy.modes[job.mode]}
              {note && <> · {note}</>}
            </p>
            <ul>
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </li>
      );
    })}
  </ol>

  <h2 class="subsection-title">{copy.educationTitle}</h2>
  <ol role="list" class="timeline compact">
    {education.map((item) => (
      <li class="entry">
        <p class="period">{item.expected ? copy.expected(item.end) : item.end}</p>
        <h3>
          {copy.degrees[item.id]} <span class="company">· {item.school}</span>
        </h3>
      </li>
    ))}
  </ol>

  <h2 class="subsection-title">{copy.languagesTitle}</h2>
  <ul role="list" class="timeline compact">
    {spokenLanguages.map((code) => (
      <li class="entry">
        <p class="period">{copy.spoken[code].level}</p>
        <h3>{copy.spoken[code].name}</h3>
      </li>
    ))}
  </ul>
</section>

<style>
  .timeline {
    display: grid;
    gap: 2.5rem;
    padding: 0;
  }

  .compact {
    gap: 1.25rem;
  }

  .entry {
    display: grid;
    align-items: baseline;
    gap: 0.25rem 2rem;
  }

  @media (min-width: 40rem) {
    .entry {
      grid-template-columns: 10rem 1fr;
    }
  }

  .period {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .company {
    font-weight: 400;
    color: var(--muted);
  }

  .where {
    margin-top: 0.125rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  ul:not([role]) {
    margin-top: 0.75rem;
    padding-inline-start: 1.1rem;
    color: var(--muted);
  }

  ul:not([role]) li + li {
    margin-top: 0.375rem;
  }

  .subsection-title {
    margin-top: 3.5rem;
  }
</style>
