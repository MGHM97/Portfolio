---
import { education, experience } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { experience: copy } = t(Astro.props.locale);
---

<section id="experience" class="container section" aria-labelledby="experience-title">
  <h2 id="experience-title" class="section-title">
    {copy.title}
  </h2>

  <ol role="list" class="timeline">
    {experience.map((job) => (
      <li class="entry">
        <p class="period">
          {job.start} — {job.end ?? copy.present}
        </p>
        <div>
          <h3>
            {copy.jobs[job.id].role} <span class="company">· {job.company}</span>
          </h3>
          <ul>
            {copy.jobs[job.id].highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <h2 class="section-title education-title">{copy.educationTitle}</h2>
  <ol role="list" class="timeline">
    {education.map((item) => (
      <li class="entry">
        <p class="period">{item.expected ? copy.expected(item.end) : item.end}</p>
        <h3>
          {copy.degrees[item.id]} <span class="company">· {item.school}</span>
        </h3>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline {
    display: grid;
    gap: 2.5rem;
    padding: 0;
  }

  .entry {
    display: grid;
    gap: 0.25rem 2rem;
  }

  @media (min-width: 40rem) {
    .entry {
      grid-template-columns: 9rem 1fr;
    }
  }

  .period {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .company {
    font-weight: 400;
    color: var(--muted);
  }

  ul {
    margin-top: 0.625rem;
    padding-left: 1.1rem;
    color: var(--muted);
  }

  li + li {
    margin-top: 0.375rem;
  }

  .education-title {
    margin-top: 4rem;
  }
</style>
