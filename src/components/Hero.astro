---
import { figures, profile } from '../data/profile';
import { splitEmphasis, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { hero } = t(Astro.props.locale);
const headline = splitEmphasis(hero.headline);
---

<section class="container hero" aria-labelledby="hero-title">
  <p class="eyebrow">
    {hero.role} — {hero.location}
  </p>

  <h1 id="hero-title">
    {headline.map((part) => (part.emphasis ? <em>{part.text}</em> : part.text))}
  </h1>

  <figure class="meeting">
    <div class="rivers" aria-hidden="true"></div>
    <figcaption>{hero.rivers}</figcaption>
  </figure>

  <p class="summary">{hero.summary}</p>

  <ul role="list" class="figures" aria-label={hero.figuresLabel}>
    {figures.map((figure) => (
      <li>
        <span class="value">{figure.value}</span>
        <span class="label">{hero.figures[figure.id]}</span>
      </li>
    ))}
  </ul>

  <div class="actions">
    <a class="button primary" href={`mailto:${profile.email}`}>
      {hero.getInTouch}
    </a>
    <a class="button" href={profile.links.linkedin} rel="me">
      LinkedIn
    </a>
    <a class="button" href={profile.links.github} rel="me">
      GitHub
    </a>
    {profile.cv && (
      <a class="button" href={profile.cv} download>
        {hero.downloadCv}
      </a>
    )}
  </div>

  <div class="availability">
    <p class="status">{hero.availability}</p>
    <p class="meta">
      {profile.timezone} · {hero.overlap}
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 10vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }

  .eyebrow {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 7.5vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .meeting {
    margin-top: 2.5rem;
  }

  figcaption {
    max-width: 30rem;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--muted);
  }

  .summary {
    max-width: 38rem;
    margin-top: 2.5rem;
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
    margin-top: 3rem;
    padding-block: 1.75rem;
    border-block: 1px solid var(--border);
  }

  @media (min-width: 40rem) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figures li {
    display: grid;
    align-content: start;
    gap: 0.375rem;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .label {
    font-size: 0.875rem;
    line-height: 1.4;
    text-wrap: pretty;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .availability {
    margin-top: 2rem;
    font-size: 0.9375rem;
  }

  .status {
    font-weight: 500;
  }

  .meta {
    margin-top: 0.25rem;
    color: var(--muted);
  }
</style>
