---
import { profile } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { hero } = t(Astro.props.locale);
---

<section class="container hero" aria-labelledby="hero-title">
  <p class="status">
    <span class="dot" aria-hidden="true"></span>
    {hero.availability}
  </p>

  <h1 id="hero-title">
    <span class="role">{hero.role}</span>
    {hero.headline}
  </h1>

  <p class="summary">{hero.summary}</p>

  <div class="actions">
    <a class="button primary" href={`mailto:${profile.email}`}>
      {hero.getInTouch}
    </a>
    <a class="button" href={profile.links.linkedin} rel="me">
      LinkedIn
    </a>
    <a class="button" href={profile.links.github} rel="me">
      GitHub
    </a>
    {profile.cv && (
      <a class="button" href={profile.cv} download>
        {hero.downloadCv}
      </a>
    )}
  </div>

  <p class="meta">
    {hero.location} · {profile.timezone}
    <br />
    {hero.overlap}
  </p>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 12vw, 7rem) clamp(3rem, 8vw, 5rem);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 2rem;
    padding: 0.375rem 0.875rem;
    background: var(--accent-soft);
    border-radius: 1rem;
    font-size: 0.875rem;
  }

  .dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border-radius: 50%;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 650;
  }

  .role {
    display: block;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .summary {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .button {
    padding: 0.625rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 150ms,
      background-color 150ms;
  }

  .button:hover {
    border-color: var(--muted);
  }

  .primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .meta {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
