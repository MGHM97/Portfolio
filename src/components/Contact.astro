---
import { profile } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { contact } = t(Astro.props.locale);
---

<section id="contact" class="container section" aria-labelledby="contact-title">
  <h2 id="contact-title" class="section-title">
    {contact.title}
  </h2>

  <p class="lead">{contact.lead}</p>

  <a class="email" href={`mailto:${profile.email}`}>
    {profile.email}
  </a>

  <ul role="list" class="links">
    <li>
      <a href={profile.links.linkedin} rel="me">
        LinkedIn
      </a>
    </li>
    <li>
      <a href={profile.links.github} rel="me">
        GitHub
      </a>
    </li>
  </ul>
</section>

<style>
  .lead {
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 1.875rem);
    line-height: 1.3;
  }

  .email {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: clamp(1.125rem, 4vw, 1.375rem);
    font-weight: 600;
    color: var(--accent);
    text-decoration-color: currentColor;
    overflow-wrap: anywhere;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }
</style>
