---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="container footer">
  <p>
    © {year} {profile.name}
  </p>
  <p>
    Built with Astro, with <a href="https://claude.com/claude-code">Claude Code</a> as pair
    programmer. <a href={`${profile.links.github}/portfolio`}>Source</a>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
