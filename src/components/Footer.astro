---
import { profile } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { footer } = t(Astro.props.locale);
const year = new Date().getFullYear();
---

<footer class="container footer">
  <p>
    © {year} {profile.name}
  </p>
  <p>
    {footer.creditBefore}
    <a href="https://claude.com/claude-code">Claude Code</a>
    {footer.creditAfter} <a href={profile.links.source}>{footer.source}</a>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
