---
import { openSource } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { openSource: copy } = t(Astro.props.locale);
---

<section id="open-source" class="container section" aria-labelledby="open-source-title">
  <h2 id="open-source-title" class="section-title">
    {copy.title}
  </h2>

  <ul role="list" class="projects">
    {openSource.map((project) => {
      const { tagline, description, highlights } = copy.projects[project.id];
      return (
        <li class="project">
          <div class="heading">
            <h3>
              <a href={project.repo}>{project.name}</a>
            </h3>
            <span class="status">{copy.status(project.version)}</span>
          </div>
          <p class="tagline">{tagline}</p>
          <p class="description">{description}</p>
          <ul role="list" class="highlights">
            {highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <ul role="list" class="stack">
            {project.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="links">
            <a class="button primary" href={project.repo}>
              {copy.source}
            </a>
            {project.demo && (
              <a class="button" href={project.demo}>
                {copy.demos}
              </a>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .project {
    padding-block: 0.25rem;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .status {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  .tagline {
    margin-top: 0.375rem;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .description {
    max-width: 38rem;
    margin-top: 0.875rem;
    color: var(--muted);
  }

  .highlights {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    position: relative;
    padding-inline-start: 1.5rem;
  }

  .highlights li::before {
    content: '—';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .stack li:not(:last-child)::after {
    content: '·';
    padding-inline: 0.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
