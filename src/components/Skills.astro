---
import { skills, type SkillGroup } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { skills: copy } = t(Astro.props.locale);
const groups = Object.entries(skills) as [SkillGroup, readonly string[]][];
---

<section id="skills" class="container section" aria-labelledby="skills-title">
  <h2 id="skills-title" class="section-title">
    {copy.title}
  </h2>

  <dl class="groups">
    {groups.map(([group, items]) => (
      <div class="group">
        <dt>{copy.groups[group]}</dt>
        <dd>
          <ul role="list">
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .groups {
    display: grid;
    gap: 1.25rem;
  }

  .group {
    display: grid;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .group:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  @media (min-width: 40rem) {
    .group {
      grid-template-columns: 10rem 1fr;
    }
  }

  dt {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    color: var(--muted);
  }

  li:not(:last-child)::after {
    content: '·';
    padding-inline: 0.5rem;
  }
</style>
