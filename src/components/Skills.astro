---
import { skills, type SkillGroup } from '../data/profile';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { skills: copy } = t(Astro.props.locale);
const groups = Object.entries(skills) as [SkillGroup, readonly string[]][];
---

<section id="skills" class="container section" aria-labelledby="skills-title">
  <h2 id="skills-title" class="section-title">
    {copy.title}
  </h2>

  <dl class="groups">
    {groups.map(([group, items]) => (
      <div class="group">
        <dt>{copy.groups[group]}</dt>
        <dd>
          <ul role="list">
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .groups {
    display: grid;
    gap: 1.5rem;
  }

  .group {
    display: grid;
    gap: 0.5rem 2rem;
  }

  @media (min-width: 40rem) {
    .group {
      grid-template-columns: 9rem 1fr;
    }
  }

  dt {
    padding-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  li {
    padding: 0.25rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.875rem;
  }
</style>
