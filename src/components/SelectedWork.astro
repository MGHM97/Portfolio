---
import { languageTags, localizePath, t, defaultLocale, type Locale } from '../i18n';
import { getWork } from '../lib/work';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const work = await getWork(locale);
---

{work.length > 0 && (
  <section id="work" class="container section" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">
      {dict.work.title}
    </h2>

    <ul role="list" class="cards">
      {work.map(({ slug, entry: { data }, isFallback }) => (
        <li class="card" lang={isFallback ? languageTags[defaultLocale] : undefined}>
          <p class="meta">
            {data.company} · {data.role}
          </p>
          <h3>
            <a href={localizePath(locale, `/work/${slug}/`)}>{data.title}</a>
          </h3>
          <p class="summary">{data.summary}</p>
          <ul role="list" class="stack" aria-label={dict.work.stack}>
            {data.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {data.draft && (
            <p class="draft" lang={languageTags[locale]}>
              {dict.work.draft}
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .cards {
    display: grid;
    border-bottom: 1px solid var(--border);
  }

  .card {
    position: relative;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
  }

  /* The section title already draws a rule; a second one right below reads as noise. */
  .card:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .meta {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  h3 {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3.5vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
  }

  h3 a {
    text-decoration: none;
    transition: color 150ms;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h3 a,
  h3 a:focus-visible {
    color: var(--accent);
  }

  .summary {
    max-width: 36rem;
    margin-top: 0.625rem;
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .stack li:not(:last-child)::after {
    content: '·';
    padding-inline: 0.5rem;
  }

  .draft {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--accent);
  }
</style>
