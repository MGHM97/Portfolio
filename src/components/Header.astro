---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';
import { localizePath, t, type Locale } from '../i18n';
import { getPosts } from '../lib/posts';
import { getWork } from '../lib/work';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = localizePath(locale);
const hasWork = (await getWork(locale)).length > 0;
const hasPosts = (await getPosts(locale)).length > 0;

const nav = [
  ...(hasWork ? [{ hash: 'work', label: dict.nav.work }] : []),
  { hash: 'open-source', label: dict.nav.openSource },
  ...(hasPosts ? [{ hash: 'writing', label: dict.nav.writing }] : []),
  { hash: 'experience', label: dict.nav.experience },
  { hash: 'skills', label: dict.nav.skills },
  { hash: 'contact', label: dict.nav.contact },
];
---

<header class="container header">
  <div class="bar">
    <a class="brand" href={home}>
      {profile.name}
    </a>
    <div class="controls">
      <LanguageSwitcher locale={locale} />
      <ThemeToggle label={dict.a11y.toggleTheme} />
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label={dict.a11y.menu}
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path class="open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="close" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav id="primary-nav" class="nav" aria-label={dict.a11y.primaryNav}>
    <ul role="list">
      {nav.map((item) => (
        <li>
          <a href={`${home}#${item.hash}`}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('header.header');
  const button = header?.querySelector<HTMLButtonElement>('.menu-button');
  const nav = header?.querySelector<HTMLElement>('#primary-nav');

  if (header && button && nav) {
    // Without this script the menu stays expanded on small screens, so it degrades gracefully.
    header.dataset.menu = 'closed';

    const setOpen = (open: boolean) => {
      header.dataset.menu = open ? 'open' : 'closed';
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => setOpen(header.dataset.menu !== 'open'));
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || header.dataset.menu !== 'open') return;
      setOpen(false);
      button.focus();
    });
    document.addEventListener('click', (event) => {
      if (header.dataset.menu === 'open' && !header.contains(event.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .header {
    padding-block: 1.5rem 0.5rem;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    margin-inline-end: auto;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .nav a {
    color: var(--muted);
    white-space: nowrap;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
  }

  .menu-button:hover,
  [data-menu='open'] .menu-button {
    color: var(--text);
    border-color: var(--muted);
  }

  .close,
  [data-menu='open'] .open {
    display: none;
  }

  [data-menu='open'] .close {
    display: inline;
  }

  @media (max-width: 40rem) {
    [data-menu] .menu-button {
      display: grid;
    }

    [data-menu='closed'] .nav {
      display: none;
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
      margin-top: 0.75rem;
      padding-block: 0.25rem;
      border-block: 1px solid var(--border);
    }

    .nav a {
      display: block;
      padding-block: 0.625rem;
      font-size: 1rem;
    }
  }
</style>
