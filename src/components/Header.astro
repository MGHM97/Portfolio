---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';
import { localizePath, t, type Locale } from '../i18n';
import { getPosts } from '../lib/posts';
import { getWork } from '../lib/work';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = localizePath(locale);
const hasWork = (await getWork(locale)).length > 0;
const hasPosts = (await getPosts(locale)).length > 0;

const nav = [
  ...(hasWork ? [{ hash: 'work', label: dict.nav.work }] : []),
  { hash: 'open-source', label: dict.nav.openSource },
  ...(hasPosts ? [{ hash: 'writing', label: dict.nav.writing }] : []),
  { hash: 'experience', label: dict.nav.experience },
  { hash: 'skills', label: dict.nav.skills },
  { hash: 'contact', label: dict.nav.contact },
];
---

<header class="container header">
  <a class="brand" href={home}>
    {profile.name}
  </a>
  <nav aria-label={dict.a11y.primaryNav}>
    <ul role="list">
      {nav.map((item) => (
        <li>
          <a href={`${home}#${item.hash}`}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="controls">
    <LanguageSwitcher locale={locale} />
    <ThemeToggle label={dict.a11y.toggleTheme} />
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }

  .brand {
    margin-inline-end: auto;
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  ul a {
    color: var(--muted);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--text);
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 48rem) {
    nav {
      display: none;
    }
  }
</style>
