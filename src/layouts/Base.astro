---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { profile } from '../data/profile';
import {
  defaultLocale,
  languageTags,
  localizePath,
  locales,
  ogLocales,
  stripLocale,
  t,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Points search engines elsewhere, e.g. to the original of an untranslated page. */
  canonicalLocale?: Locale;
  alternates?: boolean;
}

const { locale, canonicalLocale = locale, alternates = true } = Astro.props;
const dict = t(locale);
const title = Astro.props.title ?? dict.meta.title;
const description = Astro.props.description ?? dict.meta.description;

const path = stripLocale(Astro.url.pathname);
const urlFor = (target: Locale) => new URL(localizePath(target, path), Astro.site);
const canonical = urlFor(canonicalLocale);
const ogImage = new URL(`/og/${locale}.png`, Astro.site);
---

<!doctype html>
<html lang={languageTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates &&
      locales.map((target) => (
        <link rel="alternate" hreflang={languageTags[target]} href={urlFor(target)} />
      ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — ${dict.writing.title}`}
      href="/rss.xml"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales
      .filter((target) => target !== locale)
      .map((target) => (
        <meta property="og:locale:alternate" content={ogLocales[target]} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${dict.hero.role} — ${dict.hero.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {dict.a11y.skipToContent}
    </a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 10;
    padding: 0.5rem 0.875rem;
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
